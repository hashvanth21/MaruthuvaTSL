# ==============================================================================
# MARUTHUVA TSL (மருத்துவ TSL) - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=3000

# Sarvam AI Sovereign Tamil AI (Bulbul TTS & Mayura Translation)
# Obtain from https://dashboard.sarvam.ai
# Supports comma-separated keys for automatic high-availability round-robin rotation:
# SARVAM_API_KEY=key1,key2,key3
SARVAM_API_KEY=

# IndicTrans2 Clinical Neural Translation
# Default routes to local high-availability proxy /api/translate
INDICTRANS2_ENDPOINT=/api/translate

